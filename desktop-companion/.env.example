# Clé API OpenAI (ou compatible OpenAI)
COMPANION_API_KEY=sk-...

# Base URL optionnelle (OpenAI par défaut, ou proxy / Ollama compatible)
COMPANION_BASE_URL=https://api.openai.com/v1

# Modèle vision (doit accepter les images)
COMPANION_MODEL=gpt-4o-mini

# Nom du companion
COMPANION_NAME=Lumen

# Langue des réponses
COMPANION_LANGUAGE=fr